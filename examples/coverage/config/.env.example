# Copy to config/.env, edit the values, then export them with:
# set -a; source examples/coverage/config/.env; set +a
# Only configure the Harnesses selected for your run (including Simulators).

# OpenClaw: use openai-responses or openai-completions as supported by your service.
MY_PROXY_BASE_URL='https://api.example.com/v1'
MY_PROXY_API_KEY='replace-with-your-api-key'
ROLLER_TEST_OPENCLAW_API='openai-responses'
ROLLER_TEST_OPENCLAW_MODEL_ID='my-model'
ROLLER_TEST_OPENCLAW_MODEL="my-openai-proxy/${ROLLER_TEST_OPENCLAW_MODEL_ID}"

# Codex: requires a Responses endpoint.
ROLLER_CODEX_BASE_URL='https://api.example.com/v1'
ROLLER_CODEX_API_KEY='replace-with-your-api-key'
ROLLER_TEST_CODEX_MODEL='replace-codex-model'

# Claude Code: requires an Anthropic Messages endpoint.
ROLLER_ANTHROPIC_BASE_URL='https://api.example.com/v1/messages'
ROLLER_ANTHROPIC_API_KEY='replace-with-your-api-key'
ROLLER_TEST_CLAUDE_CODE_MODEL='replace-claude-model'

# Fixed, non-secret fixture used by runtime/env tasks.
ROLLER_EXAMPLE_TOKEN='ENV_OK'

# Optional image overrides; otherwise Roller uses its documented defaults.
# ROLLER_OPENCLAW_IMAGE='your-openclaw-image:tag'
# ROLLER_CODEX_IMAGE='your-codex-image:tag'
# ROLLER_CLAUDE_CODE_IMAGE='your-claude-code-image:tag'
