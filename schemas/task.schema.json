{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roller.dev/schemas/task.schema.json",
  "title": "Roller Task Bundle v1",
  "type": "object",
  "required": ["schema_version", "id"],
  "properties": {
    "schema_version": {"const": "roller.task/v1"},
    "id": {"type": ["string", "integer"]},
    "file_root": {
      "type": "string",
      "minLength": 1,
      "description": "Task workspace root for relative input/context sources and output_dir; itself relative to the task-list directory"
    },
    "prompt": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"const": "user"},
              "content": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "user_simulator": {
      "type": "object",
      "required": ["instruction"],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "Fixed persona and goal prompt given to the User Simulator on every turn"
        },
        "harness": {"const": "openclaw", "default": "openclaw"},
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Simulator model; defaults to the task-agent model"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 6,
          "description": "Maximum number of instructions delivered to the task agent"
        },
        "thinking": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "model": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "properties": {
        "output_dir": {
          "$ref": "#/$defs/relativePath",
          "default": "outputs",
          "description": "Writable subdirectory of the file_root workspace; every file under it is collected"
        },
        "inputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/relativePath"},
              {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": {"$ref": "#/$defs/relativePath"},
                  "required": {"type": "boolean", "default": true},
                  "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "source"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "target": {"$ref": "#/$defs/relativePath"},
              "capture": {"enum": ["full", "hash", "none"]},
              "required": {"type": "boolean", "default": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "env": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "setup": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "thinking": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {"required": ["prompt"]},
    {"required": ["question"]},
    {"required": ["messages"]},
    {"required": ["user_simulator"]}
  ],
  "allOf": [
    {
      "if": {"required": ["user_simulator"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["prompt"]},
            {"required": ["question"]},
            {"required": ["messages"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
    }
  },
  "additionalProperties": true
}
