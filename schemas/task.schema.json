{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roller.dev/schemas/task.schema.json",
  "title": "Roller Task Bundle v1",
  "type": "object",
  "required": ["schema_version", "id"],
  "properties": {
    "schema_version": {"const": "roller.task/v1"},
    "id": {"type": ["string", "integer"]},
    "file_root": {
      "type": "string",
      "minLength": 1,
      "description": "Base directory for relative files.*.source paths; itself relative to the task-list directory"
    },
    "prompt": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"const": "user"},
              "content": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "model": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": {"type": "string", "minLength": 1},
                  "target": {"$ref": "#/$defs/relativePath"},
                  "required": {"type": "boolean", "default": true},
                  "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "source"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "target": {"$ref": "#/$defs/relativePath"},
              "capture": {"enum": ["full", "hash", "none"]},
              "required": {"type": "boolean", "default": true}
            },
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/relativePath"},
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {"$ref": "#/$defs/relativePath"},
                  "type": {"enum": ["file", "directory", "glob"], "default": "file"},
                  "required": {"type": "boolean", "default": true},
                  "max_bytes": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "env": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "setup": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "thinking": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {"required": ["prompt"]},
    {"required": ["question"]},
    {"required": ["messages"]}
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
    }
  },
  "additionalProperties": true
}
